{
	"name": "rankmyseo-wp-plugin",
	"version": "0.1.0",
	"description": "RankMySEO WordPress plugin admin interface and build tooling.",
	"private": true,
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"typecheck": "tsc --noEmit",
		"lint:js": "wp-scripts lint-js src tests/js",
		"lint:css": "wp-scripts lint-style \"src/**/*.css\"",
		"test:js": "wp-scripts test-unit-js --config jest.config.js",
		"test:e2e": "playwright test",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.0.0",
		"@wordpress/components": "^28.0.0",
		"@wordpress/core-data": "^7.26.0",
		"@wordpress/data": "^10.26.0",
		"@wordpress/element": "^6.0.0",
		"@wordpress/i18n": "^5.0.0",
		"@wordpress/plugins": "^7.26.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.48.0",
		"@testing-library/jest-dom": "^6.5.0",
		"@testing-library/react": "^16.0.1",
		"@testing-library/user-event": "^14.5.2",
		"@types/jest": "^29.5.14",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@wordpress/env": "^10.8.0",
		"@wordpress/scripts": "^30.3.0",
		"typescript": "^5.6.3"
	}
}
