# Files omitted from the WordPress.org / GitHub release zip.
# Patterns match .gitignore. build/, vendor/, languages/, and includes/ stay.

/.git
/.github
/.cursor
/.wp-env
/.phpunit.cache
/.phpunit.result.cache

/node_modules
/src
/tests
/scripts
/dist
/coverage
/playwright-report
/test-results

/vendor/bin
/vendor/composer/installed.php
/vendor/dealerdirect
/vendor/php-stubs
/vendor/phpcompatibility
/vendor/phpstan
/vendor/phpunit
/vendor/squizlabs
/vendor/szepeviktor
/vendor/wp-coding-standards
/vendor/composer/installers

/composer.json
/composer.lock
/package.json
/package-lock.json
/phpcs.xml
/phpcs.xml.dist
/phpstan.neon
/phpstan.neon.dist
/phpstan-bootstrap.php
/phpstan-elementor-stub.php
/phpunit.xml
/phpunit.xml.dist
/webpack.config.js
/tsconfig.json
/jest.config.js
/playwright.config.ts
/playwright.config.js
/README.md
/CHANGELOG.md

/.*
!/.distignore
